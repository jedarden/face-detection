#!/bin/sh
# Health check script for Docker container

HTTP_URL=${HEALTHCHECK_HTTP_URL:-http://localhost:8080/health}
HTTPS_URL=${HEALTHCHECK_HTTPS_URL:-https://localhost:8443/health}
INDEX_FILE=${HEALTHCHECK_INDEX_FILE:-/usr/share/nginx/html/index.html}

# Check HTTP and HTTPS endpoints (ignore the self-signed certificate)
if curl -sf "$HTTP_URL" >/dev/null; then
    HTTP_STATUS=0
else
    HTTP_STATUS=$?
fi

if curl -sfk "$HTTPS_URL" >/dev/null; then
    HTTPS_STATUS=0
else
    HTTPS_STATUS=$?
fi

# Check if the main index.html exists
if [ -f "$INDEX_FILE" ]; then
    FILE_STATUS=0
else
    FILE_STATUS=1
fi

# Overall health status
if [ "$HTTP_STATUS" -eq 0 ] && [ "$HTTPS_STATUS" -eq 0 ] && [ "$FILE_STATUS" -eq 0 ]; then
    echo "Health check passed"
    exit 0
else
    echo "Health check failed:"
    [ "$HTTP_STATUS" -ne 0 ] && echo "  - HTTP endpoint not responding"
    [ "$HTTPS_STATUS" -ne 0 ] && echo "  - HTTPS endpoint not responding"
    [ "$FILE_STATUS" -ne 0 ] && echo "  - Application files missing"
    exit 1
fi
